---
layout: default
---
{% if page._styles %}
  <style type="text/css">{{ page._styles }}</style>
{% endif %}

{%- comment -%}
  i18n labels — keep terse. Most workshop pages are EN; FR sections render the FR set.
{%- endcomment -%}
{% assign is_fr = false %}
{% if page.lang == 'fr' %}{% assign is_fr = true %}{% endif %}

<article class="workshop-page" itemscope itemtype="https://schema.org/Course">
  <meta itemprop="name" content="{{ page.title }}" />
  <meta itemprop="description" content="{{ page.tagline | default: page.description }}" />
  <meta itemprop="inLanguage" content="{{ page.lang | default: 'en' }}" />
  <div itemprop="provider" itemscope itemtype="https://schema.org/Person">
    <meta itemprop="name" content="{{ page.instructor | default: site.author.name }}" />
  </div>

  {%- comment -%} === Hero === {%- endcomment -%}
  <header class="workshop-hero">
    {% if is_fr %}
      <a class="workshop-back" href="{{ '/fr/teaching/' | relative_url }}">← {{ "Retour à l'enseignement" }}</a>
    {% else %}
      <a class="workshop-back" href="{{ '/en/teaching/' | relative_url }}">← Back to teaching</a>
    {% endif %}
    <h1 class="workshop-title">{{ page.title }}</h1>
    {% if page.tagline %}
      <p class="workshop-tagline">{{ page.tagline }}</p>
    {% endif %}
  </header>

  <div class="workshop-grid">

    {%- comment -%} === Left sidebar: metadata + CTAs === {%- endcomment -%}
    <aside class="workshop-sidebar">

      {% if page.contact_email %}
        <a class="workshop-cta workshop-cta-primary"
           href="mailto:{{ page.contact_email }}?subject={{ page.contact_subject | default: page.title | url_encode }}">
          <i class="fa-solid fa-envelope"></i>
          {% if is_fr %}Inviter cet atelier{% else %}Host this workshop{% endif %}
        </a>
      {% endif %}

      <dl class="workshop-meta">
        {% if page.instructor %}
          <dt>{% if is_fr %}Formateur{% else %}Instructor{% endif %}</dt>
          <dd>{{ page.instructor }}</dd>
        {% endif %}

        {% if page.duration %}
          <dt>{% if is_fr %}Durée{% else %}Duration{% endif %}</dt>
          <dd>{{ page.duration }}</dd>
        {% endif %}

        {% if page.level %}
          <dt>{% if is_fr %}Niveau{% else %}Level{% endif %}</dt>
          <dd>{{ page.level }}</dd>
        {% endif %}

        {% if page.format %}
          <dt>{% if is_fr %}Format{% else %}Format{% endif %}</dt>
          <dd>{{ page.format }}</dd>
        {% endif %}

        {% if page.languages %}
          <dt>{% if is_fr %}Langues{% else %}Languages{% endif %}</dt>
          <dd>{{ page.languages }}</dd>
        {% endif %}

        {% if page.next_session %}
          <dt>{% if is_fr %}Prochaine session{% else %}Next session{% endif %}</dt>
          <dd>{{ page.next_session }}</dd>
        {% endif %}

        {% if page.pricing %}
          <dt>{% if is_fr %}Tarification{% else %}Pricing{% endif %}</dt>
          <dd>{{ page.pricing }}</dd>
        {% endif %}

        {% if page.certificate %}
          <dt>{% if is_fr %}Certification{% else %}Certificate{% endif %}</dt>
          <dd>{{ page.certificate }}</dd>
        {% endif %}
      </dl>

      {% if page.syllabus_pdf or page.notebooks_url or page.brochure_pdf or page.code_url %}
        <div class="workshop-materials">
          <h3>{% if is_fr %}Supports{% else %}Materials{% endif %}</h3>
          <ul>
            {% if page.syllabus_pdf %}
              <li><a href="{{ page.syllabus_pdf | relative_url }}">
                <i class="fa-solid fa-file-pdf"></i>
                {% if is_fr %}Notes de cours (PDF){% else %}Lecture notes (PDF){% endif %}
              </a></li>
            {% endif %}
            {% if page.notebooks_url %}
              <li><a href="{{ page.notebooks_url }}" target="_blank" rel="noopener">
                <i class="fa-brands fa-github"></i>
                {% if is_fr %}Notebooks{% else %}Notebooks{% endif %}
              </a></li>
            {% endif %}
            {% if page.code_url %}
              <li><a href="{{ page.code_url }}" target="_blank" rel="noopener">
                <i class="fa-solid fa-code"></i>
                {% if is_fr %}Code{% else %}Code{% endif %}
              </a></li>
            {% endif %}
            {% if page.brochure_pdf %}
              <li><a href="{{ page.brochure_pdf | relative_url }}">
                <i class="fa-solid fa-file-arrow-down"></i>
                {% if is_fr %}Plaquette (PDF){% else %}Brochure (PDF){% endif %}
              </a></li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if page.contact_email %}
        <p class="workshop-contact-note">
          {% if is_fr %}
            Conférence, université, ou équipe d'entreprise ? Écrivez pour discuter dates et format.
          {% else %}
            Conference, university, or corporate team? Write to discuss dates and format.
          {% endif %}
        </p>
      {% endif %}
    </aside>

    {%- comment -%} === Right column: main content === {%- endcomment -%}
    <div class="workshop-content">
      {{ content }}
    </div>

  </div>

  {%- comment -%} === Optional testimonials at the bottom === {%- endcomment -%}
  {% if page.testimonials %}
    <section class="workshop-testimonials">
      <h2>{% if is_fr %}Témoignages{% else %}Testimonials{% endif %}</h2>
      <div class="workshop-testimonials-list">
        {% for t in page.testimonials %}
          <figure class="workshop-testimonial">
            <blockquote>{{ t.quote }}</blockquote>
            <figcaption>
              <strong>{{ t.name }}</strong>
              {% if t.role %}<br><span class="role">{{ t.role }}</span>{% endif %}
            </figcaption>
          </figure>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>
