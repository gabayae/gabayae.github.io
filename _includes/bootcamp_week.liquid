{%- assign week_num = include.week_number -%}
{%- assign week = nil -%}
{%- for w in site.data.bootcamp.weeks -%}
  {%- if w.number == week_num -%}
    {%- assign week = w -%}
  {%- endif -%}
{%- endfor -%}

{%- if week == nil -%}
<p><em>No data found for week {{ week_num }}.</em></p>
{%- else -%}

{%- assign d = site.data.bootcamp.defaults -%}

<div class="bootcamp-week">

<p class="bootcamp-week-meta">
  <strong>Module {{ week.module }}</strong> &nbsp;|&nbsp;
  <a href="{{ '/workshops/ml-ai-bootcamp/en/schedule/' | relative_url }}">← schedule</a>
  {%- assign prev_num = week.number | minus: 1 | prepend: '0' | slice: -2, 2 -%}
  {%- assign next_num = week.number | plus: 1 | prepend: '0' | slice: -2, 2 -%}
  {%- if week.number != "01" -%}
    &nbsp;|&nbsp; <a href="{{ '/workshops/ml-ai-bootcamp/en/week-' | append: prev_num | append: '/' | relative_url }}">← week {{ prev_num }}</a>
  {%- endif -%}
  {%- if week.number != "10" -%}
    &nbsp;|&nbsp; <a href="{{ '/workshops/ml-ai-bootcamp/en/week-' | append: next_num | append: '/' | relative_url }}">week {{ next_num }} →</a>
  {%- endif -%}
</p>

<blockquote><p>{{ week.pitch }}</p></blockquote>

<h2>What you ship this week</h2>
<p>{{ week.deliverable | markdownify | remove: "<p>" | remove: "</p>" }}</p>
<table class="bootcamp-deliverable">
  <tr><th>Due</th><td>{{ d.default_deliverable_due }} ({{ d.timezone }})</td></tr>
  <tr><th>Submission</th><td>{{ d.default_submission }}</td></tr>
  <tr><th>Rubric</th><td>{{ d.default_rubric }}</td></tr>
</table>

<h2>Live sessions and labs</h2>
<p>Default weekly cadence below. Cohort-specific dates and Zoom links fill in at intake.</p>
<table class="bootcamp-cadence">
  <thead><tr><th>Day</th><th>Time</th><th>Block</th><th>Recording</th></tr></thead>
  <tbody>
  {% for slot in d.weekly_cadence %}
    <tr>
      <td>{{ slot.day }}</td>
      <td><code>{{ slot.time }}</code></td>
      <td>{{ slot.block }}</td>
      <td><em>(post-session)</em></td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Learning outcomes</h2>
<p>By the end of the week, every participant will:</p>
<ol>
  {% for lo in week.learning_outcomes %}
    <li>{{ lo | markdownify | remove: "<p>" | remove: "</p>" }}</li>
  {% endfor %}
</ol>

<h2>Topics covered</h2>
<p>{{ week.topics | markdownify | remove: "<p>" | remove: "</p>" }}</p>

<h2>Labs</h2>
{% for lab in week.labs %}
<h3>Lab {{ forloop.index }} — {{ lab.title }}</h3>
<p>{{ lab.task | markdownify | remove: "<p>" | remove: "</p>" }}</p>
<p><strong>Dataset:</strong> {{ lab.dataset }}</p>
{% endfor %}

<h2>Readings</h2>
{% if week.readings.mandatory and week.readings.mandatory.size > 0 %}
<h3>Mandatory</h3>
<ul>
  {% for r in week.readings.mandatory %}
    <li>
      <strong>Before {{ r.before }}.</strong>
      {% if r.url and r.url != "" %}
        <a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.ref }}</a>
      {% else %}
        {{ r.ref }}
      {% endif %}
    </li>
  {% endfor %}
</ul>
{% endif %}
{% if week.readings.optional and week.readings.optional.size > 0 %}
<h3>Optional deepening</h3>
<ul>
  {% for r in week.readings.optional %}
    <li>
      {% if r.url and r.url != "" %}
        <a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.ref }}</a>
      {% else %}
        {{ r.ref }}
      {% endif %}
      {% if r.note %} — <em>{{ r.note }}</em>{% endif %}
    </li>
  {% endfor %}
</ul>
{% endif %}

{% if week.catalogue and week.catalogue.size > 0 %}
<h2>Builds on (course catalogue)</h2>
<ul>
  {% for c in week.catalogue %}
    <li><a href="{{ '/courses/' | append: c.slug | append: '/' | relative_url }}">{{ c.label }}</a></li>
  {% endfor %}
</ul>
{% endif %}

</div>
{%- endif -%}
