{%- assign week_num = include.week_number -%}
{%- assign week = nil -%}
{%- for w in site.data.bootcamp_fr.weeks -%}
  {%- if w.number == week_num -%}
    {%- assign week = w -%}
  {%- endif -%}
{%- endfor -%}

{%- if week == nil -%}
<p><em>Aucune donnée trouvée pour la semaine {{ week_num }}.</em></p>
{%- else -%}

{%- assign d = site.data.bootcamp_fr.defaults -%}

<div class="bootcamp-week">

<p class="bootcamp-week-meta">
  <strong>Module {{ week.module }}</strong> &nbsp;|&nbsp;
  <a href="{{ '/workshops/ml-ai-bootcamp/fr/schedule/' | relative_url }}">← planning</a>
  {%- assign prev_num = week.number | minus: 1 | prepend: '0' | slice: -2, 2 -%}
  {%- assign next_num = week.number | plus: 1 | prepend: '0' | slice: -2, 2 -%}
  {%- if week.number != "01" -%}
    &nbsp;|&nbsp; <a href="{{ '/workshops/ml-ai-bootcamp/fr/week-' | append: prev_num | append: '/' | relative_url }}">← semaine {{ prev_num }}</a>
  {%- endif -%}
  {%- if week.number != "10" -%}
    &nbsp;|&nbsp; <a href="{{ '/workshops/ml-ai-bootcamp/fr/week-' | append: next_num | append: '/' | relative_url }}">semaine {{ next_num }} →</a>
  {%- endif -%}
</p>

<blockquote><p>{{ week.pitch }}</p></blockquote>

<h2>Livrable de la semaine</h2>
<p>{{ week.deliverable | markdownify | remove: "<p>" | remove: "</p>" }}</p>
<table class="bootcamp-deliverable">
  <tr><th>Échéance</th><td>{{ d.default_deliverable_due }} ({{ d.timezone }})</td></tr>
  <tr><th>Soumission</th><td>{{ d.default_submission }}</td></tr>
  <tr><th>Grille</th><td>{{ d.default_rubric }}</td></tr>
</table>

<h2>Sessions en direct et ateliers</h2>
<p>Cadence hebdomadaire par défaut ci-dessous. Les dates spécifiques à la cohorte et les liens Zoom sont ajoutés à l'inscription.</p>
<table class="bootcamp-cadence">
  <thead><tr><th>Jour</th><th>Horaire</th><th>Bloc</th><th>Enregistrement</th></tr></thead>
  <tbody>
  {% for slot in d.weekly_cadence %}
    <tr>
      <td>{{ slot.day }}</td>
      <td><code>{{ slot.time }}</code></td>
      <td>{{ slot.block }}</td>
      <td><em>(après la session)</em></td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<h2>Objectifs d'apprentissage</h2>
<p>À l'issue de la semaine, chaque participant saura&nbsp;:</p>
<ol>
  {% for lo in week.learning_outcomes %}
    <li>{{ lo | markdownify | remove: "<p>" | remove: "</p>" }}</li>
  {% endfor %}
</ol>

<h2>Sujets abordés</h2>
<p>{{ week.topics | markdownify | remove: "<p>" | remove: "</p>" }}</p>

<h2>Ateliers</h2>
{% for lab in week.labs %}
<h3>Atelier {{ forloop.index }} — {{ lab.title }}</h3>
<p>{{ lab.task | markdownify | remove: "<p>" | remove: "</p>" }}</p>
<p><strong>Jeu de données&nbsp;:</strong> {{ lab.dataset }}</p>
{% endfor %}

<h2>Lectures</h2>
{% if week.readings.mandatory and week.readings.mandatory.size > 0 %}
<h3>Obligatoires</h3>
<ul>
  {% for r in week.readings.mandatory %}
    <li>
      <strong>Avant {{ r.before }}.</strong>
      {% if r.url and r.url != "" %}
        <a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.ref }}</a>
      {% else %}
        {{ r.ref }}
      {% endif %}
    </li>
  {% endfor %}
</ul>
{% endif %}
{% if week.readings.optional and week.readings.optional.size > 0 %}
<h3>Pour aller plus loin</h3>
<ul>
  {% for r in week.readings.optional %}
    <li>
      {% if r.url and r.url != "" %}
        <a href="{{ r.url }}" target="_blank" rel="noopener">{{ r.ref }}</a>
      {% else %}
        {{ r.ref }}
      {% endif %}
      {% if r.note %} — <em>{{ r.note }}</em>{% endif %}
    </li>
  {% endfor %}
</ul>
{% endif %}

{% if week.catalogue and week.catalogue.size > 0 %}
<h2>Se construit sur (catalogue des cours)</h2>
<ul>
  {% for c in week.catalogue %}
    <li><a href="{{ '/courses/' | append: c.slug | append: '/' | relative_url }}">{{ c.label }}</a></li>
  {% endfor %}
</ul>
{% endif %}

</div>
{%- endif -%}
