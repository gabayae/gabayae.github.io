\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Pipeline RLHF conceptuel (pseudocode simplifi\PYGZbs{}\PYGZsq{}e)}
\PYG{c+c1}{\PYGZsh{} En pratique, utilisez des biblioth\PYGZbs{}`eques comme trl (Transformer Reinforcement Learning)}

\PYG{c+c1}{\PYGZsh{} 1. Collecter des donn\PYGZbs{}\PYGZsq{}ees de pr\PYGZbs{}\PYGZsq{}ef\PYGZbs{}\PYGZsq{}erence}
\PYG{n}{preferences} \PYG{o}{=} \PYG{p}{[}
    \PYG{p}{\PYGZob{}}\PYG{l+s+s2}{\PYGZdq{}prompt\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}Explain gravity\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}chosen\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}Gravity is...\PYGZdq{}}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}rejected\PYGZdq{}}\PYG{p}{:} \PYG{l+s+s2}{\PYGZdq{}IDK\PYGZdq{}}\PYG{p}{\PYGZcb{},}
    \PYG{c+c1}{\PYGZsh{} ... des milliers de paires}
\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} 2. Entra\PYGZbs{}\PYGZca{}iner le mod\PYGZbs{}`ele de r\PYGZbs{}\PYGZsq{}ecompense}
\PYG{c+c1}{\PYGZsh{} reward\PYGZus{}model = train\PYGZus{}reward\PYGZus{}model(preferences)}

\PYG{c+c1}{\PYGZsh{} 3. Optimisation PPO}
\PYG{c+c1}{\PYGZsh{} from trl import PPOTrainer, PPOConfig}
\PYG{c+c1}{\PYGZsh{} ppo\PYGZus{}config = PPOConfig(batch\PYGZus{}size=16, learning\PYGZus{}rate=1e\PYGZhy{}5)}
\PYG{c+c1}{\PYGZsh{} ppo\PYGZus{}trainer = PPOTrainer(model, ref\PYGZus{}model, tokenizer, ppo\PYGZus{}config)}
\PYG{c+c1}{\PYGZsh{} for batch in dataloader:}
\PYG{c+c1}{\PYGZsh{}     rewards = reward\PYGZus{}model(batch.responses)}
\PYG{c+c1}{\PYGZsh{}     ppo\PYGZus{}trainer.step(batch.queries, batch.responses, rewards)}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}RLHF is computationally expensive. DPO is a simpler alternative.\PYGZdq{}}\PYG{p}{)}
\end{MintedVerbatim}
