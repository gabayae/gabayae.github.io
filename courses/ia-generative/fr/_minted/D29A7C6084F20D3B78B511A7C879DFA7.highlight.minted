\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Prompt de style ReAct (conceptuel)}
\PYG{n}{react\PYGZus{}prompt} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Answer the question using the available tools.}

\PYG{l+s+s2}{Tools:}
\PYG{l+s+s2}{\PYGZhy{} search(query): search the web for information}
\PYG{l+s+s2}{\PYGZhy{} calculator(expression): evaluate a math expression}

\PYG{l+s+s2}{Question: What is the population of Benin multiplied by 3?}

\PYG{l+s+s2}{Thought: I need to find the population of Benin first.}
\PYG{l+s+s2}{Action: search(\PYGZdq{}population of Benin 2025\PYGZdq{})}
\PYG{l+s+s2}{Observation: The population of Benin is approximately 14.4 million.}
\PYG{l+s+s2}{Thought: Now I need to multiply 14.4 million by 3.}
\PYG{l+s+s2}{Action: calculator(\PYGZdq{}14400000 * 3\PYGZdq{})}
\PYG{l+s+s2}{Observation: 43200000}
\PYG{l+s+s2}{Thought: I have the answer.}
\PYG{l+s+s2}{Answer: The population of Benin multiplied by 3 is approximately 43,200,000.\PYGZdq{}\PYGZdq{}\PYGZdq{}}

\PYG{n+nb}{print}\PYG{p}{(}\PYG{n}{react\PYGZus{}prompt}\PYG{p}{)}
\end{MintedVerbatim}
