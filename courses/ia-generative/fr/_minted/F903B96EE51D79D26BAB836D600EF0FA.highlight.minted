\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{sentence\PYGZus{}transformers}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{SentenceTransformer}
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{numpy}\PYG{+w}{ }\PYG{k}{as}\PYG{+w}{ }\PYG{n+nn}{np}

\PYG{n}{model} \PYG{o}{=} \PYG{n}{SentenceTransformer}\PYG{p}{(}\PYG{l+s+s2}{\PYGZdq{}all\PYGZhy{}MiniLM\PYGZhy{}L6\PYGZhy{}v2\PYGZdq{}}\PYG{p}{)}

\PYG{n}{sentences} \PYG{o}{=} \PYG{p}{[}
    \PYG{l+s+s2}{\PYGZdq{}The patient has a high fever and cough.\PYGZdq{}}\PYG{p}{,}
    \PYG{l+s+s2}{\PYGZdq{}Machine learning is a subset of artificial intelligence.\PYGZdq{}}\PYG{p}{,}
    \PYG{l+s+s2}{\PYGZdq{}The patient presents with elevated temperature and respiratory symptoms.\PYGZdq{}}\PYG{p}{,}
\PYG{p}{]}

