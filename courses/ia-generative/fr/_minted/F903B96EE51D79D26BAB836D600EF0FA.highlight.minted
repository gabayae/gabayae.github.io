\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Embedding shape: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{embeddings}\PYG{o}{.}\PYG{n}{shape}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}  \PYG{c+c1}{\PYGZsh{} (3, 384)}

\PYG{c+c1}{\PYGZsh{} Similarit\PYGZbs{}\PYGZsq{}e cosinus}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{sklearn.metrics.pairwise}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{cosine\PYGZus{}similarity}
