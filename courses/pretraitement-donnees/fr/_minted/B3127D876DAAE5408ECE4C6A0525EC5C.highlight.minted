\PYG{p}{]}

\PYG{c+c1}{\PYGZsh{} Extraire la tension art\PYGZbs{}\PYGZsq{}erielle}
\PYG{n}{bp\PYGZus{}pattern} \PYG{o}{=} \PYG{l+s+sa}{r}\PYG{l+s+s1}{\PYGZsq{}(\PYGZbs{}d\PYGZob{}2,3\PYGZcb{})/(\PYGZbs{}d\PYGZob{}2,3\PYGZcb{})\PYGZbs{}s*mmHg\PYGZsq{}}
\PYG{k}{for} \PYG{n}{t} \PYG{o+ow}{in} \PYG{n}{texts}\PYG{p}{:}
    \PYG{n}{match} \PYG{o}{=} \PYG{n}{re}\PYG{o}{.}\PYG{n}{search}\PYG{p}{(}\PYG{n}{bp\PYGZus{}pattern}\PYG{p}{,} \PYG{n}{t}\PYG{p}{)}
    \PYG{k}{if} \PYG{n}{match}\PYG{p}{:}
        \PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Systolic: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{match}\PYG{o}{.}\PYG{n}{group}\PYG{p}{(}\PYG{l+m+mi}{1}\PYG{p}{)}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{, Diastolic: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{match}\PYG{o}{.}\PYG{n}{group}\PYG{p}{(}\PYG{l+m+mi}{2}\PYG{p}{)}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} Extraire tous les nombres avec unit\PYGZbs{}\PYGZsq{}es}
\PYG{n}{num\PYGZus{}unit} \PYG{o}{=} \PYG{l+s+sa}{r}\PYG{l+s+s1}{\PYGZsq{}(\PYGZbs{}d+\PYGZbs{}.?\PYGZbs{}d*)\PYGZbs{}s*(mg/dL|mmHg|bpm|\PYGZpc{})\PYGZsq{}}
