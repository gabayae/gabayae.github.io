\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{k+kn}{import}\PYG{+w}{ }\PYG{n+nn}{re}

\PYG{c+c1}{\PYGZsh{} Extraire des donn\PYGZbs{}\PYGZsq{}ees structur\PYGZbs{}\PYGZsq{}ees d\PYGZsq{}un texte non structur\PYGZbs{}\PYGZsq{}e}
\PYG{n}{texts} \PYG{o}{=} \PYG{p}{[}
