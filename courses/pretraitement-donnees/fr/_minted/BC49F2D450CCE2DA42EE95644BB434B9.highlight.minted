\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Return a boolean mask of rows with any z\PYGZhy{}score outlier.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{mask} \PYG{o}{=} \PYG{n}{pd}\PYG{o}{.}\PYG{n}{Series}\PYG{p}{(}\PYG{k+kc}{False}\PYG{p}{,} \PYG{n}{index}\PYG{o}{=}\PYG{n}{df}\PYG{o}{.}\PYG{n}{index}\PYG{p}{)}
