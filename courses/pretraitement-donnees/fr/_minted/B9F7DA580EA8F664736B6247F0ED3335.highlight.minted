\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{mahalanobis\PYGZus{}outliers}\PYG{p}{(}\PYG{n}{df}\PYG{p}{,} \PYG{n}{columns}\PYG{p}{,} \PYG{n}{threshold}\PYG{o}{=}\PYG{l+m+mi}{3}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}Detect multivariate outliers using Mahalanobis distance.\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{data} \PYG{o}{=} \PYG{n}{df}\PYG{p}{[}\PYG{n}{columns}\PYG{p}{]}\PYG{o}{.}\PYG{n}{dropna}\PYG{p}{()}
