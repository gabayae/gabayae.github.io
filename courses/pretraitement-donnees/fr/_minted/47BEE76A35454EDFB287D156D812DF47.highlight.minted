\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Supprimer les colonnes \PYGZbs{}`a plus de 50\PYGZpc{} manquantes}
\PYG{n}{threshold} \PYG{o}{=} \PYG{l+m+mf}{0.5}
\PYG{n}{cols\PYGZus{}to\PYGZus{}drop} \PYG{o}{=} \PYG{n}{df}\PYG{o}{.}\PYG{n}{columns}\PYG{p}{[}\PYG{n}{df}\PYG{o}{.}\PYG{n}{isnull}\PYG{p}{()}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{()} \PYG{o}{\PYGZgt{}} \PYG{n}{threshold}\PYG{p}{]}\PYG{o}{.}\PYG{n}{tolist}\PYG{p}{()}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Dropping columns: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{cols\PYGZus{}to\PYGZus{}drop}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
