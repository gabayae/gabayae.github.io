\PYG{n}{url} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}https://en.wikipedia.org/wiki/List\PYGZus{}of\PYGZus{}countries\PYGZus{}by\PYGZus{}GDP\PYGZus{}(nominal)\PYGZdq{}}
\PYG{n}{response} \PYG{o}{=} \PYG{n}{requests}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{n}{url}\PYG{p}{)}
