\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Tokenisation par espaces vs NLTK}
\PYG{n}{text\PYGZus{}fr} \PYG{o}{=} \PYG{l+s+s2}{\PYGZdq{}L\PYGZsq{}analyse du Dr. N\PYGZsq{}Guessan montre que c\PYGZsq{}est significatif.\PYGZdq{}}

\PYG{c+c1}{\PYGZsh{} Split par espace : rate les contractions}
\PYG{n}{simple\PYGZus{}tokens} \PYG{o}{=} \PYG{n}{text\PYGZus{}fr}\PYG{o}{.}\PYG{n}{split}\PYG{p}{()}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}Simple: }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{simple\PYGZus{}tokens}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}

\PYG{c+c1}{\PYGZsh{} NLTK : g\PYGZbs{}`ere contractions et abr\PYGZbs{}\PYGZsq{}eviations}
\PYG{n}{nltk\PYGZus{}tokens} \PYG{o}{=} \PYG{n}{word\PYGZus{}tokenize}\PYG{p}{(}\PYG{n}{text\PYGZus{}fr}\PYG{p}{,} \PYG{n}{language}\PYG{o}{=}\PYG{l+s+s2}{\PYGZdq{}french\PYGZdq{}}\PYG{p}{)}
\PYG{n+nb}{print}\PYG{p}{(}\PYG{l+s+sa}{f}\PYG{l+s+s2}{\PYGZdq{}NLTK:   }\PYG{l+s+si}{\PYGZob{}}\PYG{n}{nltk\PYGZus{}tokens}\PYG{l+s+si}{\PYGZcb{}}\PYG{l+s+s2}{\PYGZdq{}}\PYG{p}{)}
\end{MintedVerbatim}
