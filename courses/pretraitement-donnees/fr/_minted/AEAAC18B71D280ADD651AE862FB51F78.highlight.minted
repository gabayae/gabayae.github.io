\begin{MintedVerbatim}[commandchars=\\\{\}]
\PYG{c+c1}{\PYGZsh{} Strat\PYGZbs{}\PYGZsq{}egie 1 : supprimer les lignes aberrantes}
\PYG{n}{df\PYGZus{}clean} \PYG{o}{=} \PYG{n}{df}\PYG{p}{[}\PYG{o}{\PYGZti{}}\PYG{n}{outlier\PYGZus{}mask}\PYG{p}{]}\PYG{o}{.}\PYG{n}{copy}\PYG{p}{()}

\PYG{c+c1}{\PYGZsh{} Strat\PYGZbs{}\PYGZsq{}egie 2 : capper (winsorize) aux bornes}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{scipy.stats}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{mstats}
\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}Overall\PYGZus{}winsorized\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{mstats}\PYG{o}{.}\PYG{n}{winsorize}\PYG{p}{(}\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}Overall\PYGZdq{}}\PYG{p}{],} \PYG{n}{limits}\PYG{o}{=}\PYG{p}{[}\PYG{l+m+mf}{0.01}\PYG{p}{,} \PYG{l+m+mf}{0.01}\PYG{p}{])}

\PYG{c+c1}{\PYGZsh{} Strat\PYGZbs{}\PYGZsq{}egie 3 : remplacer par NaN et imputer plus tard}
\PYG{n}{df}\PYG{o}{.}\PYG{n}{loc}\PYG{p}{[}\PYG{n}{outlier\PYGZus{}mask}\PYG{p}{,} \PYG{l+s+s2}{\PYGZdq{}Overall\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{nan}

\PYG{c+c1}{\PYGZsh{} Strat\PYGZbs{}\PYGZsq{}egie 4 : transformation log pour r\PYGZbs{}\PYGZsq{}eduire l\PYGZsq{}asym\PYGZbs{}\PYGZsq{}etrie}
\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}Value\PYGZus{}log\PYGZdq{}}\PYG{p}{]} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{log1p}\PYG{p}{(}\PYG{n}{df}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}Value(in Euro)\PYGZdq{}}\PYG{p}{]}\PYG{o}{.}\PYG{n}{clip}\PYG{p}{(}\PYG{n}{lower}\PYG{o}{=}\PYG{l+m+mi}{0}\PYG{p}{))}

\PYG{c+c1}{\PYGZsh{} Strat\PYGZbs{}\PYGZsq{}egie 5 : mise \PYGZbs{}`a l\PYGZsq{}\PYGZbs{}\PYGZsq{}echelle robuste (moins sensible aux outliers)}
\PYG{k+kn}{from}\PYG{+w}{ }\PYG{n+nn}{sklearn.preprocessing}\PYG{+w}{ }\PYG{k+kn}{import} \PYG{n}{RobustScaler}
\PYG{n}{scaler} \PYG{o}{=} \PYG{n}{RobustScaler}\PYG{p}{()}  \PYG{c+c1}{\PYGZsh{} utilise m\PYGZbs{}\PYGZsq{}ediane et IQR au lieu de moyenne et std}
\PYG{n}{df}\PYG{p}{[[}\PYG{l+s+s2}{\PYGZdq{}Overall\PYGZus{}robust\PYGZdq{}}\PYG{p}{]]} \PYG{o}{=} \PYG{n}{scaler}\PYG{o}{.}\PYG{n}{fit\PYGZus{}transform}\PYG{p}{(}\PYG{n}{df}\PYG{p}{[[}\PYG{l+s+s2}{\PYGZdq{}Overall\PYGZdq{}}\PYG{p}{]])}
\end{MintedVerbatim}
